<script>
// ===== AUDIO =====
const AudioCtx = window.AudioContext || window.webkitAudioContext;
let audioCtx;
function initAudio() { if (!audioCtx) audioCtx = new AudioCtx(); }
function tone(f, type, dur, vol) {
  if (!audioCtx) return;
  const o = audioCtx.createOscillator(), g = audioCtx.createGain();
  o.connect(g); g.connect(audioCtx.destination);
  o.frequency.value = f; o.type = type;
  g.gain.setValueAtTime(vol || 0.08, audioCtx.currentTime);
  g.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + dur);
  o.start(audioCtx.currentTime); o.stop(audioCtx.currentTime + dur);
}
function sfxLevelUp() {
  [523, 659, 784, 1047, 1319].forEach((f, i) => setTimeout(() => tone(f, 'square', 0.22, 0.1), i * 110));
}
function sfxCoin() {
  tone(880, 'square', 0.07);
  setTimeout(() => tone(1100, 'square', 0.09, 0.08), 70);
}
function sfxBlow() {
  tone(320, 'sine', 0.35, 0.12);
  setTimeout(() => tone(180, 'sine', 0.45, 0.08), 120);
}
function sfxWish() {
  tone(600 + Math.random() * 500, 'sine', 0.08, 0.05);
}

// ===== LOCALSTORAGE =====
const KEY = 'wang_bday_v3';
let state = { candles: 0, gifts: [], wishes: 0, quests: [], first: true, typed: false, allDone: false };

function load() {
  try {
    const s = localStorage.getItem(KEY);
    if (s) { const p = JSON.parse(s); state = { ...state, ...p }; }
    if (!Array.isArray(state.gifts)) state.gifts = [];
    if (!Array.isArray(state.quests)) state.quests = [];
  } catch (e) {}
}
function save() {
  try { localStorage.setItem(KEY, JSON.stringify(state)); showSave(); } catch (e) {}
}
function showSave() {
  const el = document.getElementById('saveInd');
  el.classList.add('on');
  setTimeout(() => el.classList.remove('on'), 1200);
}
function resetProgress() {
  if (confirm('⚠️ Reset semua progress dan mulai dari awal?')) {
    localStorage.removeItem(KEY);
    location.reload();
  }
}

// ===== RESTORE UI =====
function restore() {
  // Candles
  for (let i = 1; i <= state.candles; i++) {
    const c = document.getElementById('c' + i);
    if (c) c.classList.add('off');
  }
  if (state.candles >= 3) {
    document.getElementById('blowBtn').disabled = true;
    document.getElementById('blowBtn').textContent = '✅ SEMUA LILIN DITIUP!';
    document.getElementById('blowBtn').classList.add('done');
    document.getElementById('cakeHint').textContent = '🎉 Quest Make a Wish - COMPLETED!';
    document.getElementById('q1').classList.add('done');
  }
  // Gifts
  state.gifts.forEach(n => {
    const g = document.getElementById('g' + n);
    if (g) { g.classList.add('open'); g.querySelector('.g-emoji').textContent = ['🎉','✨','💰','😊'][n - 1] || '🎉'; }
  });
  if (state.gifts.length >= 4) document.getElementById('q2').classList.add('done');
  // Wishes
  document.getElementById('wishScore').textContent = 'Wishes: ' + state.wishes + ' / 25';
  if (state.wishes >= 25) document.getElementById('q3').classList.add('done');
  // Quests
  state.quests.forEach(q => { const el = document.getElementById(q); if (el) el.classList.add('done'); });
  // Typing
  if (state.typed) {
    document.getElementById('typeText').innerHTML = 'Selamat ulang tahun yang ke-25, Wang! 🎉 Di level 25 ini, semoga HP-mu selalu full, MP-mu tak terbatas, dan XP-mu terus naik! Terima kasih sudah menjadi party member terbaik dalam game kehidupan ini. Semoga quest kehidupanmu selalu berakhir dengan VICTORY! 🏆<br><br><span style="color:var(--pink)">🎮 Player 2 is ready to continue this adventure together! 💕</span>';
  }
  // All done?
  if (state.allDone) {
    setTimeout(() => showFinalWishes(), 1000);
  }
}

function completeQuest(qid) {
  if (!state.quests.includes(qid)) { state.quests.push(qid); save(); }
  const el = document.getElementById(qid);
  if (el) el.classList.add('done');
  checkAll();
}

function checkAll() {
  const all = ['q1', 'q2', 'q3', 'q4'];
  const done = all.every(q => state.quests.includes(q));
  if (done && !state.allDone) {
    state.allDone = true;
    save();
    setTimeout(() => showAch('🏆 Birthday Champion', 'Semua quest selesai! Wang adalah legenda!'), 600);
    setTimeout(() => showFinalWishes(), 2200);
  }
}

// ===== FINAL WISHES =====
function showFinalWishes() {
  const panel = document.getElementById('finalWishes');
  if (!panel) return;
  panel.classList.add('show');
  panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
  sfxLevelUp();
  launchConfetti(80);
  setTimeout(() => launchConfetti(50), 400);
  setTimeout(() => launchConfetti(50), 800);
  const cards = panel.querySelectorAll('.fw-card');
  cards.forEach((card, i) => {
    setTimeout(() => {
      card.classList.add('visible');
      tone(450 + i * 70, 'sine', 0.25, 0.06);
    }, i * 350 + 400);
  });
}

// ===== START GAME =====
function startGame() {
  initAudio();
  sfxCoin();
  document.getElementById('startScreen').classList.add('hidden');
  setTimeout(() => {
    document.getElementById('game').classList.add('active');
    if (state.first) {
      state.first = false;
      save();
      setTimeout(showLevelUp, 500);
    }
    if (!state.typed) startTyping();
    setTimeout(() => { document.getElementById('xpBar').style.width = '100%'; }, 1200);
    restore();
  }, 1000);
}

function showLevelUp() {
  document.getElementById('levelUp').classList.add('active');
  sfxLevelUp();
  launchConfetti(35);
}
function closeLevelUp() {
  sfxCoin();
  document.getElementById('levelUp').classList.remove('active');
  showAch('Level 25!', 'Wang has grown stronger!');
}

// ===== BLOW CANDLE =====
function blowCandle() {
  if (state.candles >= 3) return;
  state.candles++;
  sfxBlow();
  const c = document.getElementById('c' + state.candles);
  c.classList.add('off');
  fx();
  save();
  if (state.candles === 3) {
    document.getElementById('blowBtn').disabled = true;
    document.getElementById('blowBtn').textContent = '✅ SEMUA LILIN DITIUP!';
    document.getElementById('blowBtn').classList.add('done');
    document.getElementById('cakeHint').textContent = '🎉 Quest Make a Wish - COMPLETED!';
    completeQuest('q1');
    showAch('Wish Maker', 'Semua lilin berhasil ditiup!');
    launchConfetti(50);
    setTimeout(() => launchConfetti(40), 300);
    setTimeout(() => launchConfetti(40), 600);
  }
}

// ===== GIFTS =====
function openGift(num) {
  if (state.gifts.includes(num)) return;
  sfxCoin();
  state.gifts.push(num);
  const g = document.getElementById('g' + num);
  g.classList.add('open');
  const emojis = ['🎉', '✨', '💰', '😊'];
  g.querySelector('.g-emoji').textContent = emojis[num - 1] || '🎉';
  fx();
  save();
  if (state.gifts.length >= 4) {
    completeQuest('q2');
    showAch('Treasure Master', 'Semua hadiah dibuka!');
  }
}

// ===== WISH CLICKER =====
function clickWish() {
  state.wishes++;
  sfxWish();
  document.getElementById('wishScore').textContent = 'Wishes: ' + state.wishes + ' / 25';
  const orb = document.getElementById('orb');
  orb.style.transform = 'scale(0.8)';
  setTimeout(() => orb.style.transform = 'scale(1)', 90);
  if (state.wishes % 4 === 0) fx();
  save();
  if (state.wishes === 25) {
    completeQuest('q3');
    showAch('Wish Collector', '25 wishes terkumpul!');
    launchConfetti(50);
  }
}

// ===== ACHIEVEMENT =====
let achTimer;
function showAch(title, desc) {
  const p = document.getElementById('ach');
  document.getElementById('achTitle').textContent = title;
  document.getElementById('achDesc').textContent = desc;
  p.classList.add('show');
  sfxLevelUp();
  clearTimeout(achTimer);
  achTimer = setTimeout(() => p.classList.remove('show'), 3500);
}

// ===== TYPING =====
const msg = "Selamat ulang tahun yang ke-25, Wang! 🎉 Di level 25 ini, semoga HP-mu selalu full, MP-mu tak terbatas, dan XP-mu terus naik! Terima kasih sudah menjadi party member terbaik dalam game kehidupan ini. Semoga quest kehidupanmu selalu berakhir dengan VICTORY! 🏆 Player 2 is ready to continue this adventure together! 💕";
function startTyping() {
  const el = document.getElementById('typeText');
  let i = 0;
  const iv = setInterval(() => {
    if (i < msg.length) {
      el.innerHTML = msg.substring(0, i + 1) + '<span class="type-cursor"></span>';
      i++;
      if (i % 8 === 0) tone(750, 'sine', 0.03, 0.025);
    } else {
      clearInterval(iv);
      el.innerHTML = msg + '<span class="type-cursor"></span>';
      state.typed = true;
      save();
      completeQuest('q4');
    }
  }, 42);
}

// ===== PARTICLES =====
const cvs = document.getElementById('particles');
const ctx = cvs.getContext('2d');
let pts = [];
function resize() { cvs.width = window.innerWidth; cvs.height = window.innerHeight; }
resize(); window.addEventListener('resize', resize);
class Pt {
  constructor() { this.reset(); }
  reset() {
    this.x = Math.random() * cvs.width; this.y = Math.random() * cvs.height;
    this.s = Math.random() * 2.5 + 0.5;
    this.vx = (Math.random() - 0.5) * 0.4;
    this.vy = (Math.random() - 0.5) * 0.4;
    this.c = ['#ff2d95', '#00f3ff', '#bc13fe', '#39ff14', '#fff01f'][Math.floor(Math.random() * 5)];
    this.a = Math.random() * 0.4 + 0.15;
  }
  update() { this.x += this.vx; this.y += this.vy; if (this.x < 0 || this.x > cvs.width || this.y < 0 || this.y > cvs.height) this.reset(); }
  draw() { ctx.beginPath(); ctx.arc(this.x, this.y, this.s, 0, Math.PI * 2); ctx.fillStyle = this.c; ctx.globalAlpha = this.a; ctx.fill(); ctx.globalAlpha = 1; }
}
for (let i = 0; i < 70; i++) pts.push(new Pt());
function animPts() { ctx.clearRect(0, 0, cvs.width, cvs.height); pts.forEach(p => { p.update(); p.draw(); }); requestAnimationFrame(animPts); }
animPts();

// ===== CONFETTI & HEARTS =====
function launchConfetti(n) {
  for (let i = 0; i < n; i++) {
    setTimeout(() => {
      const c = document.createElement('div');
      c.className = 'confetti';
      c.style.left = Math.random() * 100 + 'vw';
      c.style.backgroundColor = ['#ff2d95', '#00f3ff', '#bc13fe', '#39ff14', '#fff01f', '#ff6600'][Math.floor(Math.random() * 6)];
      c.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
      c.style.width = (Math.random() * 7 + 5) + 'px';
      c.style.height = c.style.width;
      c.style.animationDuration = (Math.random() * 1.8 + 1.5) + 's';
      document.body.appendChild(c);
      setTimeout(() => c.remove(), 3300);
    }, i * 25);
  }
}
function fx() {
  for (let i = 0; i < 20; i++) {
    const c = document.createElement('div');
    c.className = 'confetti';
    c.style.left = Math.random() * 100 + 'vw';
    c.style.backgroundColor = ['#ff2d95', '#00f3ff', '#bc13fe', '#39ff14', '#fff01f'][Math.floor(Math.random() * 5)];
    c.style.borderRadius = Math.random() > 0.5 ? '50%' : '0';
    c.style.animationDuration = (Math.random() * 2 + 2) + 's';
    document.body.appendChild(c);
    setTimeout(() => c.remove(), 4000);
  }
  for (let i = 0; i < 5; i++) {
    setTimeout(() => {
      const h = document.createElement('div');
      h.className = 'heart';
      h.textContent = ['❤️', '💖', '💕', '💗', '💝', '🎉', '✨', '🌟'][Math.floor(Math.random() * 8)];
      h.style.left = Math.random() * 80 + 10 + 'vw';
      h.style.bottom = '70px';
      h.style.animationDuration = (Math.random() * 2 + 2.5) + 's';
      document.body.appendChild(h);
      setTimeout(() => h.remove(), 4500);
    }, i * 150);
  }
}

// ===== MOUSE TRAIL =====
document.addEventListener('mousemove', (e) => {
  if (Math.random() > 0.93) {
    const s = document.createElement('div');
    s.style.cssText = 'position:fixed;left:' + e.clientX + 'px;top:' + e.clientY + 'px;width:5px;height:5px;background:' + ['#ff2d95', '#00f3ff', '#bc13fe', '#fff01f'][Math.floor(Math.random() * 4)] + ';border-radius:50%;pointer-events:none;z-index:9999;box-shadow:0 0 6px currentColor;';
    document.body.appendChild(s);
    setTimeout(() => { s.style.transition = 'all 0.35s'; s.style.opacity = '0'; s.style.transform = 'scale(0)'; setTimeout(() => s.remove(), 350); }, 70);
  }
});

// ===== KEYBOARD =====
document.addEventListener('keydown', (e) => {
  if (e.code === 'Space') {
    e.preventDefault();
    fx();
    launchConfetti(25);
    sfxCoin();
  }
});

// ===== INIT =====
load();
</script>
</body>
