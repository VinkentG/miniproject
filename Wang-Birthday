<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>🎮 HAPPY BIRTHDAY WANG - LEVEL 25!</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Orbitron:wght@400;700;900&display=swap" rel="stylesheet">
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{
--pink:#ff2d95;--blue:#00f3ff;--purple:#bc13fe;
--green:#39ff14;--yellow:#fff01f;--bg:#0a0a1a;--panel:rgba(10,10,30,0.93)}
body{background:var(--bg);color:#fff;font-family:'Orbitron',sans-serif;overflow-x:hidden;min-height:100vh}
#particles{position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:1000}
.scanlines{position:fixed;top:0;left:0;width:100%;height:100%;background:repeating-linear-gradient(0deg,rgba(0,0,0,0.03),rgba(0,0,0,0.03)1px,transparent 1px,transparent 2px);pointer-events:none;z-index:9998}

/* START SCREEN */
#startScreen{position:fixed;top:0;left:0;width:100%;height:100%;background:linear-gradient(135deg,#0a0a1a,#1a0a2e,#0a0a1a);display:flex;flex-direction:column;align-items:center;justify-content:center;z-index:9999;transition:opacity 1.2s,transform 1.2s}
#startScreen.hidden{opacity:0;transform:scale(1.3);pointer-events:none}
.game-title{font-family:'Press Start 2P',cursive;font-size:clamp(1.1rem,4vw,2.2rem);text-align:center;color:var(--yellow);text-shadow:0 0 10px var(--yellow),0 0 30px var(--pink),0 0 60px var(--purple);animation:titlePulse 2.5s ease-in-out infinite;margin-bottom:15px;line-height:1.7}
.game-subtitle{font-size:clamp(0.75rem,2vw,1.1rem);color:var(--blue);text-shadow:0 0 10px var(--blue);margin-bottom:35px;animation:blink 1.2s step-end infinite}
.press-start{font-family:'Press Start 2P',cursive;font-size:clamp(0.7rem,2vw,1.1rem);color:var(--green);text-shadow:0 0 10px var(--green);animation:blink 0.9s step-end infinite;cursor:pointer;padding:18px 36px;border:3px solid var(--green);border-radius:12px;background:rgba(57,255,20,0.08);transition:all 0.3s}
.press-start:hover{background:rgba(57,255,20,0.25);transform:scale(1.12);box-shadow:0 0 35px var(--green)}
.start-avatar{width:130px;height:130px;border-radius:50%;border:4px solid var(--yellow);overflow:hidden;margin-bottom:25px;box-shadow:0 0 40px var(--purple);animation:floatAvatar 2.5s ease-in-out infinite}
.start-avatar img{width:100%;height:100%;object-fit:cover}
.start-footer{margin-top:30px;font-size:0.6rem;color:rgba(255,255,255,0.35);text-align:center;line-height:1.8}

/* LEVEL UP */
#levelUp{position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.92);display:none;align-items:center;justify-content:center;flex-direction:column;z-index:5000;padding:20px}
#levelUp.active{display:flex;animation:fadeIn 0.6s}
.lvl-text{font-family:'Press Start 2P',cursive;font-size:clamp(1.3rem,5vw,2.8rem);color:var(--yellow);text-shadow:0 0 25px var(--yellow),0 0 50px var(--pink);animation:bounce 0.6s ease-in-out infinite alternate;margin-bottom:15px}
.lvl-num{font-size:clamp(5rem,15vw,10rem);font-weight:900;background:linear-gradient(180deg,#fff,var(--yellow),#ff8800);-webkit-background-clip:text;-webkit-text-fill-color:transparent;animation:growNum 2s ease-out;filter:drop-shadow(0 0 40px var(--yellow))}
.lvl-sub{color:var(--blue);font-size:1rem;margin:10px 0 25px}
.lvl-stats{display:flex;gap:15px;flex-wrap:wrap;justify-content:center;margin-bottom:25px}
.lvl-stat{background:var(--panel);border:2px solid var(--green);border-radius:12px;padding:14px 22px;text-align:center;animation:slideUp 0.6s ease}
.lvl-stat .n{font-size:0.7rem;color:var(--blue)}
.lvl-stat .v{font-size:1.4rem;color:var(--green);font-weight:700}

/* GAME SCREEN */
#game{display:none;min-height:100vh;padding:12px;background:radial-gradient(ellipse at 20% 50%,rgba(188,19,254,0.1)0%,transparent 50%),radial-gradient(ellipse at 80% 50%,rgba(0,243,255,0.1)0%,transparent 50%),var(--bg)}
#game.active{display:block;animation:fadeIn 1s}

/* HUD */
.hud{display:flex;justify-content:space-between;align-items:center;padding:12px 18px;background:var(--panel);border:2px solid var(--blue);border-radius:15px;margin-bottom:12px;box-shadow:0 0 20px rgba(0,243,255,0.25);flex-wrap:wrap;gap:10px;max-width:1400px;margin-left:auto;margin-right:auto}
.hud-avatar{width:52px;height:52px;border-radius:50%;border:3px solid var(--yellow);overflow:hidden;animation:floatAvatar 3s ease-in-out infinite;box-shadow:0 0 18px var(--purple);flex-shrink:0}
.hud-avatar img{width:100%;height:100%;object-fit:cover}
.hud-name{font-size:1rem;font-weight:700;color:var(--yellow);text-shadow:0 0 8px var(--yellow)}
.hud-class{font-size:0.65rem;color:var(--blue)}
.hud-bars{display:flex;flex-direction:column;gap:5px;min-width:170px;flex:1;max-width:280px}
.bar{display:flex;align-items:center;gap:6px}
.bar-lbl{font-size:0.55rem;font-family:'Press Start 2P',cursive;width:32px}
.bar-bg{flex:1;height:14px;background:rgba(255,255,255,0.06);border-radius:7px;overflow:hidden;border:1px solid rgba(255,255,255,0.1)}
.bar-fill{height:100%;border-radius:7px;transition:width 2.5s ease;position:relative;overflow:hidden}
.bar-fill::after{content:'';position:absolute;top:0;left:0;right:0;bottom:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,0.25),transparent);animation:shimmer 2.5s infinite}
.bar-hp{background:linear-gradient(90deg,#ff4444,#ff8888);width:100%}
.bar-mp{background:linear-gradient(90deg,#4444ff,#8888ff);width:90%}
.bar-xp{background:linear-gradient(90deg,#ffaa00,#ffdd44);width:0%}
.hud-lvl{background:linear-gradient(135deg,var(--yellow),#ff8800);color:#000;padding:7px 14px;border-radius:10px;font-family:'Press Start 2P',cursive;font-size:0.65rem;text-align:center;box-shadow:0 0 18px rgba(255,240,31,0.45);animation:lvlPulse 1.2s ease-in-out infinite;flex-shrink:0}
.hud-lvl span{font-size:1.3rem;display:block;color:#fff}

/* GRID */
.grid{display:grid;grid-template-columns:1fr 1.7fr 1fr;gap:12px;max-width:1400px;margin:0 auto}
@media(max-width:1024px){.grid{grid-template-columns:1fr}}
.pnl{background:var(--panel);border:2px solid;border-radius:15px;padding:16px;box-shadow:0 0 18px rgba(0,0,0,0.4)}
.pnl-left{border-color:var(--purple)}
.pnl-center{border-color:var(--pink)}
.pnl-right{border-color:var(--blue)}
.pnl-tit{font-family:'Press Start 2P',cursive;font-size:0.7rem;margin-bottom:10px;padding-bottom:8px;border-bottom:2px dashed rgba(255,255,255,0.12)}
.pnl-left .pnl-tit{color:var(--purple)}
.pnl-center .pnl-tit{color:var(--pink)}
.pnl-right .pnl-tit{color:var(--blue)}

/* PARTY */
.member{display:flex;align-items:center;gap:10px;padding:9px;margin-bottom:7px;background:rgba(255,255,255,0.03);border-radius:10px;border-left:3px solid var(--purple);transition:all 0.3s;cursor:pointer}
.member:hover{background:rgba(188,19,254,0.12);transform:translateX(6px)}
.mem-ava{width:45px;height:45px;border-radius:50%;border:2px solid var(--purple);overflow:hidden;flex-shrink:0;box-shadow:0 0 8px rgba(188,19,254,0.25)}
.mem-ava img{width:100%;height:100%;object-fit:cover}
.mem-name{font-size:0.8rem;color:#fff}
.mem-role{font-size:0.6rem;color:var(--blue)}
.mem-status{margin-left:auto;width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 6px var(--green);animation:pulse 2s infinite;flex-shrink:0}

/* SKILLS */
.skills{display:grid;grid-template-columns:repeat(2,1fr);gap:7px;margin-top:8px}
.skill{background:rgba(255,255,255,0.03);padding:9px 5px;border-radius:8px;text-align:center;border:1px solid rgba(255,255,255,0.06);transition:all 0.3s}
.skill:hover{border-color:var(--purple);transform:translateY(-3px);background:rgba(188,19,254,0.08)}
.skill-ico{font-size:1.3rem;margin-bottom:3px}
.skill-nm{font-size:0.6rem;color:var(--blue)}
.skill-lvl{font-size:0.8rem;color:var(--yellow);font-weight:700}

/* CAKE - CSS PURE */
.cake-wrap{text-align:center;padding:18px 0}
.cake-box{position:relative;display:inline-block;cursor:pointer;transition:transform 0.3s}
.cake-box:hover{transform:scale(1.04)}
.cake{position:relative;width:250px;display:flex;flex-direction:column;align-items:center;padding-top:40px}
/* CANDLES */
.candles{position:absolute;top:-5px;left:50%;transform:translateX(-50%);display:flex;gap:32px;z-index:20}
.cndl{position:relative;width:11px;height:36px;background:linear-gradient(180deg,#fff 0%,#ffdd88 35%,#ffaa00 100%);border-radius:4px 4px 0 0;border:1px solid rgba(255,255,255,0.25);box-shadow:0 2px 5px rgba(0,0,0,0.2)}
.cndl::before{content:'';position:absolute;bottom:-2px;left:-4px;width:19px;height:7px;background:linear-gradient(180deg,#ff6b9d,#c44569);border-radius:4px}
.cndl .fire{position:absolute;top:-24px;left:50%;transform:translateX(-50%);width:16px;height:24px;background:radial-gradient(ellipse at 50% 85%,#ff4400 0%,#ffaa00 30%,#ffdd44 55%,#fff 80%,transparent 100%);border-radius:50% 50% 50% 50%/65% 65% 35% 35%;animation:fireAnim 0.12s ease-in-out infinite alternate;box-shadow:0 0 18px #ff6600,0 0 35px #ffdd44}
.cndl .fire::after{content:'';position:absolute;top:4px;left:50%;transform:translateX(-50%);width:7px;height:11px;background:radial-gradient(ellipse,#fff,#ffdd44,transparent);border-radius:50%}
.cndl.off .fire{display:none}
.cndl.off{background:linear-gradient(180deg,#bbb 0%,#888 100%);filter:brightness(0.7)}
.cndl.off::before{background:linear-gradient(180deg,#999,#666)}
.cndl.off::after{content:'💨';position:absolute;top:-35px;left:50%;transform:translateX(-50%);font-size:1.1rem;animation:smokeOut 1.2s ease forwards}
/* LAYERS - top to bottom in DOM, visual order via flex */
.layer-top{width:155px;height:52px;background:linear-gradient(180deg,#ffd5cc 0%,#fab1a0 30%,#e17055 65%,#d63031 100%);border-radius:8px 8px 12px 12px;position:relative;z-index:4;border:2px solid rgba(255,255,255,0.05);box-shadow:inset 0 -4px 10px rgba(0,0,0,0.1);order:1}
.layer-mid{width:195px;height:62px;background:linear-gradient(180deg,#fff8dc 0%,#ffeaa7 30%,#fdcb6e 65%,#e1b12c 100%);border-radius:8px 8px 12px 12px;position:relative;z-index:3;border:2px solid rgba(255,255,255,0.05);box-shadow:inset 0 -5px 10px rgba(0,0,0,0.08);order:2;margin-top:-2px}
.layer-bot{width:235px;height:72px;background:linear-gradient(180deg,#f9dcc4 0%,#eac0a0 30%,#d4a574 65%,#b8956a 100%);border-radius:8px 8px 14px 14px;position:relative;z-index:2;border:2px solid rgba(255,255,255,0.05);box-shadow:inset 0 -6px 12px rgba(0,0,0,0.1);order:3;margin-top:-2px}
.plate{width:265px;height:16px;background:linear-gradient(180deg,#f5f5f5,#999);border-radius:50%;position:relative;z-index:1;box-shadow:0 10px 25px rgba(0,0,0,0.45);order:4;margin-top:-4px}
/* FILLING LINES */
.layer-bot::before{content:'';position:absolute;top:22px;left:10px;right:10px;height:10px;background:linear-gradient(90deg,#ff6b9d,#c44569,#ff6b9d);border-radius:5px;opacity:0.9}
.layer-mid::before{content:'';position:absolute;top:18px;left:10px;right:10px;height:8px;background:linear-gradient(90deg,#74b9ff,#0984e3,#74b9ff);border-radius:4px;opacity:0.9}
/* FROSTING */
.frost{position:absolute;top:-12px;left:3px;right:3px;height:20px;background:linear-gradient(180deg,#fff 0%,#fff8e7 45%,#ffeaa7 100%);border-radius:15px 15px 22px 22px;z-index:5;box-shadow:0 3px 12px rgba(0,0,0,0.1)}
.drip{position:absolute;top:10px;width:15px;background:linear-gradient(180deg,#fff8e7,#ffeaa7);border-radius:0 0 15px 15px;z-index:5}
/* SPRINKLES */
.sprk{position:absolute;width:8px;height:4px;border-radius:2px;z-index:6}
.cake-hint{margin-top:14px;font-size:0.95rem;color:var(--pink);text-shadow:0 0 8px var(--pink);animation:blink 2.2s step-end infinite}
.btn-blow{margin-top:12px;padding:12px 28px;background:linear-gradient(135deg,var(--pink),var(--purple));border:none;border-radius:25px;color:#fff;font-family:'Orbitron',sans-serif;font-size:0.95rem;font-weight:700;cursor:pointer;box-shadow:0 0 18px rgba(255,45,149,0.45);transition:all 0.3s}
.btn-blow:hover{transform:scale(1.08);box-shadow:0 0 35px rgba(255,45,149,0.7)}
.btn-blow:disabled{opacity:0.5;cursor:not-allowed;transform:none}
.btn-blow.done{background:linear-gradient(135deg,var(--green),#00aa00);box-shadow:0 0 18px rgba(57,255,20,0.45)}

/* ANIME GALLERY */
.gallery{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:12px}
.gal-card{position:relative;border-radius:12px;overflow:hidden;border:2px solid var(--pink);box-shadow:0 0 12px rgba(255,45,149,0.15);transition:all 0.35s;cursor:pointer;aspect-ratio:1}
.gal-card:hover{transform:scale(1.06) rotate(1deg);box-shadow:0 0 25px rgba(255,45,149,0.4);border-color:var(--yellow)}
.gal-card img{width:100%;height:100%;object-fit:cover;display:block}
.gal-card .gal-lbl{position:absolute;bottom:0;left:0;right:0;background:linear-gradient(transparent,rgba(0,0,0,0.85));padding:22px 8px 8px;font-size:0.6rem;color:#fff;text-align:center}

/* MINI GAME */
.mini-game{text-align:center;padding:14px;margin-top:14px;background:rgba(255,255,255,0.02);border-radius:12px;border:1px dashed rgba(255,255,255,0.08)}
.mini-lbl{font-size:0.75rem;color:var(--blue);margin-bottom:8px}
.orb{width:85px;height:85px;margin:8px auto;background:radial-gradient(circle,var(--pink),var(--purple));border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:2rem;cursor:pointer;box-shadow:0 0 22px rgba(255,45,149,0.4);transition:all 0.08s;user-select:none;border:3px solid rgba(255,255,255,0.15);animation:orbFloat 2s ease-in-out infinite}
.orb:active{transform:scale(0.82)}
.orb-score{font-family:'Press Start 2P',cursive;font-size:1.1rem;color:var(--yellow);margin-top:8px}
.orb-sub{font-size:0.65rem;color:rgba(255,255,255,0.45);margin-top:4px}

/* GIFTS */
.gifts{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:10px}
.gift{aspect-ratio:1;background:linear-gradient(135deg,rgba(0,243,255,0.12),rgba(188,19,254,0.12));border:2px dashed var(--blue);border-radius:12px;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:all 0.35s;position:relative;overflow:hidden;flex-direction:column;padding:8px;text-align:center}
.gift::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:linear-gradient(45deg,transparent,rgba(255,255,255,0.06),transparent);transform:rotate(45deg);transition:all 0.5s}
.gift:hover::before{left:100%}
.gift:hover{transform:scale(1.08) rotate(2deg);border-color:var(--yellow);box-shadow:0 0 22px rgba(255,240,31,0.25)}
.gift.open{background:linear-gradient(135deg,rgba(57,255,20,0.12),rgba(0,243,255,0.12));border-color:var(--green);border-style:solid;animation:giftPop 0.5s ease}
.gift .g-emoji{font-size:1.8rem;transition:all 0.3s}
.gift.open .g-emoji{font-size:1.2rem}
.gift-msg{font-size:0.6rem;color:var(--yellow);line-height:1.4;opacity:0;transition:opacity 0.4s;padding:0 4px}
.gift.open .gift-msg{opacity:1}

/* QUESTS */
.quest{padding:10px;margin-bottom:7px;background:rgba(0,243,255,0.03);border-radius:10px;border-left:3px solid var(--blue);transition:all 0.3s}
.quest.done{border-left-color:var(--green);background:rgba(57,255,20,0.06)}
.quest.done .q-tit{color:var(--green)}
.quest.done .q-tit::after{content:' ✓';color:var(--green)}
.q-tit{font-size:0.78rem;font-weight:700;margin-bottom:3px;color:#fff}
.q-desc{font-size:0.68rem;color:rgba(255,255,255,0.6)}
.q-reward{font-size:0.6rem;color:var(--yellow);margin-top:3px}

/* TIMELINE */
.time{margin-top:10px}
.time-item{display:flex;gap:10px;padding:7px 0;border-left:2px solid var(--purple);padding-left:16px;position:relative}
.time-item::before{content:'';position:absolute;left:-5px;top:11px;width:8px;height:8px;background:var(--purple);border-radius:50%;box-shadow:0 0 8px var(--purple)}
.time-item:last-child::before{background:var(--yellow);box-shadow:0 0 12px var(--yellow);animation:pulse 1.5s infinite}
.time-item:last-child{border-left-color:var(--yellow)}
.time-yr{font-size:0.72rem;color:var(--yellow);font-weight:700;min-width:42px}
.time-ev{font-size:0.72rem;color:rgba(255,255,255,0.8)}

/* ACHIEVEMENT */
#ach{position:fixed;top:90px;right:-400px;background:var(--panel);border:2px solid var(--yellow);border-radius:15px;padding:16px;display:flex;align-items:center;gap:12px;box-shadow:0 0 25px rgba(255,240,31,0.25);z-index:4000;transition:right 0.5s ease;max-width:300px}
#ach.show{right:15px}
.ach-ico{font-size:2rem}
.ach-txt h4{color:var(--yellow);font-size:0.8rem;margin-bottom:3px}
.ach-txt p{font-size:0.68rem;color:rgba(255,255,255,0.8)}

/* BOTTOM MSG */
.btm-msg{max-width:1400px;margin:12px auto 0;background:var(--panel);border:2px solid var(--yellow);border-radius:15px;padding:20px;text-align:center;box-shadow:0 0 20px rgba(255,240,31,0.12)}
.btm-msg h2{font-family:'Press Start 2P',cursive;font-size:clamp(0.65rem,2vw,0.95rem);color:var(--yellow);margin-bottom:10px;line-height:1.8}
.type-text{font-size:0.85rem;color:#fff;line-height:1.7;min-height:55px}
.type-cursor{display:inline-block;width:3px;height:1.1em;background:var(--green);animation:blink 0.7s step-end infinite;vertical-align:middle;margin-left:3px}

/* FINAL WISHES */
#finalWishes{max-width:1400px;margin:18px auto 0;background:linear-gradient(135deg,rgba(188,19,254,0.12),rgba(0,243,255,0.12),rgba(255,45,149,0.08));border:3px solid var(--yellow);border-radius:20px;padding:28px;text-align:center;box-shadow:0 0 35px rgba(255,240,31,0.2);display:none;position:relative;overflow:hidden}
#finalWishes::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,240,31,0.04)0%,transparent 60%);animation:spin 12s linear infinite}
#finalWishes.show{display:block;animation:slideUp 1s ease}
.fw-tit{font-family:'Press Start 2P',cursive;font-size:clamp(0.8rem,3vw,1.2rem);color:var(--yellow);text-shadow:0 0 15px var(--yellow),0 0 30px var(--pink);margin-bottom:22px;position:relative;z-index:1}
.fw-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:14px;position:relative;z-index:1}
.fw-card{background:rgba(10,10,30,0.85);border:2px solid;border-radius:14px;padding:18px;text-align:left;transition:all 0.4s;opacity:0;transform:translateY(25px)}
.fw-card.visible{opacity:1;transform:translateY(0)}
.fw-card:nth-child(1){border-color:var(--pink)}
.fw-card:nth-child(2){border-color:var(--blue)}
.fw-card:nth-child(3){border-color:var(--purple)}
.fw-card:nth-child(4){border-color:var(--green)}
.fw-card:nth-child(5){border-color:var(--yellow)}
.fw-card:nth-child(6){border-color:#ff6b6b}
.fw-card:hover{transform:translateY(-6px) scale(1.02);box-shadow:0 12px 35px rgba(0,0,0,0.35)}
.fw-emoji{font-size:2.2rem;margin-bottom:8px;display:block}
.fw-card h3{font-size:0.9rem;color:#fff;margin-bottom:8px}
.fw-card p{font-size:0.78rem;color:rgba(255,255,255,0.75);line-height:1.65}
.fw-btm{margin-top:22px;padding:18px;background:rgba(255,240,31,0.06);border:2px dashed var(--yellow);border-radius:14px;position:relative;z-index:1}
.fw-btm p{font-family:'Press Start 2P',cursive;font-size:clamp(0.6rem,2vw,0.8rem);color:var(--yellow);line-height:2;text-shadow:0 0 8px rgba(255,240,31,0.25)}
.fw-hearts{font-size:2.2rem;margin-top:12px;animation:titlePulse 2.5s ease-in-out infinite}

/* SAVE INDICATOR */
#saveInd{position:fixed;bottom:12px;left:12px;background:rgba(57,255,20,0.12);border:1px solid var(--green);border-radius:8px;padding:5px 10px;font-size:0.6rem;color:var(--green);z-index:5000;display:flex;align-items:center;gap:5px;opacity:0;transition:opacity 0.3s}
#saveInd.on{opacity:1}
#saveInd .dot{width:5px;height:5px;background:var(--green);border-radius:50%;animation:pulse 1s infinite}

/* RESET */
