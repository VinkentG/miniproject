{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gonjiam-asylum-ticket",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-04",
  "observability": {
    "enabled": true
  },

  // Halaman (public/index.html) disajikan sebagai static asset.
  // /api/* selalu masuk ke Worker dulu, supaya router asset tidak membalas 404
  // sebelum binding KV sempat dibaca.
  "assets": {
    "directory": "./public",
    "run_worker_first": ["/api/*"]
  },

  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "f27f5be1b64646b28757d91a48457aa9"
    }
  ]
}
